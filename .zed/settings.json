// このリポジトリ専用の Zed 設定。
// tsgo 拡張（"TypeScript Language Server"）を TS 7.1 beta で動かし、content mapper を有効にする。
// vtsls（TS 5/6）は content mapper を知らず `.parquet` などの import を TS2307 にするので、
// TypeScript 系の全言語で外して tsgo だけを動かす。
{
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "JSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    }
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.1.0-beta"
      },
      // --runExternalCode に相当。信頼できるワークスペースでだけ有効にすること
      "initialization_options": {
        "runExternalCode": true
      }
    }
  }
}
