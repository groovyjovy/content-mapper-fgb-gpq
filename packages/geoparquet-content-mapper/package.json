{
  "name": "geoparquet-content-mapper",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript content mapper that types GeoParquet imports from their footer (schema + geo metadata)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "./src/mapper.ts"
      ]
    }
  },
  "dependencies": {
    "hyparquet": "^1.31.5",
    "ts-content-mapper": "^0.1.0"
  },
  "devDependencies": {
    "hyparquet-compressors": "^1.1.2"
  }
}
