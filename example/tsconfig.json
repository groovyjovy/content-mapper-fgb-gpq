{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "contentMappers": [
    { "package": "geoparquet-content-mapper", "extensions": [".parquet", ".parquet.ref"] }
  ]
}
